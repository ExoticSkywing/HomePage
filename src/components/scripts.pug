//- Torus Glass Intro Animation Module
script(type="module").
	import { initTorusGlass } from './assets/js/torus-glass.js';
	
	// 绝杀 3：<script type="module">本身就在主 DOM 树解析后(deferred)运行！
	// 如果在这里加 DOMContentLoaded，超过一半概率会因为"晚了一步"而永远等不到信号被执行导致白屏死站！
	// 所以我们直接拿掉所有的监听外壳，顺势直接执行！
	const brandText = "ManYuZO"; 
	
	if (document.querySelector('.content-intro')) {
		// 保存 cleanup 函数到全局，供 switchPage 时销毁动画释放 GPU
		window._destroyTorusGlass = initTorusGlass('#intro-torus-canvas', brandText);
	}
